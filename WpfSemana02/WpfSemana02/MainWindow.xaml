<Window x:Class="WpfSemana02.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inicio de sesión" Height="360" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="#F1F5F9">
        <Border Width="340" Padding="30" Background="White" CornerRadius="12">
            <StackPanel>
                <TextBlock Text="CONTROL DE TRANSPORTE" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,25"/>
                <TextBlock Text="Usuario"/>
                <TextBox x:Name="txtUsuario" Height="34" Margin="0,5,0,15" Padding="8"/>
                <TextBlock Text="Contraseña"/>
                <PasswordBox x:Name="txtPassword" Height="34" Margin="0,5,0,22" Padding="8"/>
                <Button Content="INGRESAR" Height="38" Background="#2563EB" Foreground="White"
                        FontWeight="Bold" Click="Ingresar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
