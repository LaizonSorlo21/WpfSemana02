<Window x:Class="WpfSemana02.CatalogoWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mantenimiento" Height="520" Width="850" WindowStartupLocation="CenterOwner" Background="#F1F5F9">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <TextBlock x:Name="txtTitulo" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>
  <Border Grid.Row="1" Background="White" Padding="16" CornerRadius="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
   <StackPanel Margin="5"><TextBlock x:Name="lbl1"/><TextBox x:Name="campo1" Height="34"/></StackPanel>
   <StackPanel Grid.Column="1" Margin="5"><TextBlock x:Name="lbl2"/><TextBox x:Name="campo2" Height="34"/></StackPanel>
   <StackPanel Grid.Column="2" Margin="5"><TextBlock x:Name="lbl3"/><ComboBox x:Name="lista3" Height="34" Visibility="Collapsed"/><TextBox x:Name="campo3" Height="34"/></StackPanel>
   <Button Grid.Column="3" Content="GUARDAR" Height="36" Margin="5,19,5,0" Click="Guardar_Click"/>
  </Grid></Border>
  <DataGrid x:Name="grilla" Grid.Row="2" Margin="0,16,0,0" AutoGenerateColumns="True" IsReadOnly="True" MouseDoubleClick="Eliminar_DobleClick"/>
 </Grid>
</Window>
