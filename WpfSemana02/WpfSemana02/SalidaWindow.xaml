<Window x:Class="WpfSemana02.SalidaWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Registrar salida" Height="540" Width="900" WindowStartupLocation="CenterOwner" Background="#F1F5F9">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <TextBlock Text="REGISTRO DE SALIDA" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>
  <Border Grid.Row="1" Background="White" Padding="15" CornerRadius="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
   <StackPanel Margin="5"><TextBlock Text="Ingreso pendiente"/><ComboBox x:Name="cboIngreso" Height="35" SelectionChanged="Ingreso_Changed"/></StackPanel>
   <StackPanel Grid.Column="1" Margin="5"><TextBlock Text="Peso de salida / tara (kg)"/><TextBox x:Name="txtPesoSalida" Height="35"/></StackPanel>
   <Button Grid.Column="2" Content="REGISTRAR" Height="37" Margin="5,19,5,0" Click="Registrar_Click"/>
  </Grid></Border>
  <DataGrid x:Name="dgPendientes" Grid.Row="2" Margin="0,16,0,0" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns>
   <DataGridTextColumn Header="Ingreso" Binding="{Binding FechaHora, StringFormat=dd/MM/yyyy}" Width="110"/><DataGridTextColumn Header="Placa" Binding="{Binding Placa}" Width="100"/><DataGridTextColumn Header="Conductor" Binding="{Binding Conductor}" Width="*"/><DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="*"/><DataGridTextColumn Header="Peso ingreso" Binding="{Binding Peso, StringFormat=N2}" Width="120"/>
  </DataGrid.Columns></DataGrid>
 </Grid>
</Window>
