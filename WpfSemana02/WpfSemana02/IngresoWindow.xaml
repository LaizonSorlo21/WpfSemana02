<Window x:Class="WpfSemana02.IngresoWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Registrar ingreso" Height="590" Width="720" WindowStartupLocation="CenterOwner" Background="#F1F5F9"><Grid Margin="25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="REGISTRO DE INGRESO" FontSize="24" FontWeight="Bold" Margin="0,0,0,16"/><Border Grid.Row="1" Background="White" Padding="20" CornerRadius="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
<StackPanel Margin="6"><TextBlock Text="Tipo de documento"/><ComboBox x:Name="cboTipo" Height="34"><ComboBoxItem Content="DNI"/><ComboBoxItem Content="RUC"/><ComboBoxItem Content="Guía"/></ComboBox></StackPanel><StackPanel Grid.Column="1" Margin="6"><TextBlock Text="Número de documento"/><TextBox x:Name="txtNumero" Height="34"/></StackPanel>
<StackPanel Grid.Row="1" Margin="6"><TextBlock Text="Camión"/><ComboBox x:Name="cboCamion" Height="34" DisplayMemberPath="Placa"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Margin="6"><TextBlock Text="Turno"/><ComboBox x:Name="cboTurno" Height="34"><ComboBoxItem Content="Mañana"/><ComboBoxItem Content="Tarde"/><ComboBoxItem Content="Noche"/></ComboBox></StackPanel>
<StackPanel Grid.Row="2" Margin="6"><TextBlock Text="Conductor"/><ComboBox x:Name="cboConductor" Height="34" DisplayMemberPath="Nombre"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="1" Margin="6"><TextBlock Text="Cliente"/><TextBox x:Name="txtCliente" Height="34"/></StackPanel>
<StackPanel Grid.Row="3" Margin="6"><TextBlock Text="Fecha"/><DatePicker x:Name="dpFecha" Height="34"/></StackPanel><StackPanel Grid.Row="3" Grid.Column="1" Margin="6"><TextBlock Text="Peso de ingreso (kg)"/><TextBox x:Name="txtPeso" Height="34"/></StackPanel>
<StackPanel Grid.Row="4" Margin="6"><TextBlock Text="Producto"/><ComboBox x:Name="cboProducto" Height="34" DisplayMemberPath="Nombre"/></StackPanel><Button Grid.Row="4" Grid.Column="1" Content="GUARDAR INGRESO" Height="40" Margin="6,20,6,6" Click="Guardar_Click"/>
</Grid></Border></Grid></Window>
