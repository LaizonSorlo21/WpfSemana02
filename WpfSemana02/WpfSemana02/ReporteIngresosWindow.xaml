<Window x:Class="WpfSemana02.ReporteIngresosWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Reporte de movimientos" Height="600" Width="1100" WindowStartupLocation="CenterOwner" Background="#F1F5F9"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="REPORTE DE MOVIMIENTOS" FontSize="24" FontWeight="Bold" Margin="0,0,0,14"/><Border Grid.Row="1" Background="White" CornerRadius="10" Padding="12"><WrapPanel><DatePicker x:Name="dpInicio" Width="140" Margin="4"/><DatePicker x:Name="dpFin" Width="140" Margin="4"/><TextBox x:Name="txtBuscar" Width="240" Margin="4" ToolTip="Placa, conductor, cliente o producto"/><ComboBox x:Name="cboEstado" Width="130" Margin="4"><ComboBoxItem Content="Todos"/><ComboBoxItem Content="En patio"/><ComboBoxItem Content="Finalizado"/></ComboBox><Button Content="BUSCAR" Margin="4" Click="Buscar_Click"/><Button Content="LIMPIAR" Margin="4" Background="#64748B" Click="Limpiar_Click"/></WrapPanel></Border><DataGrid x:Name="dgReporte" Grid.Row="2" Margin="0,14,0,0" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding FechaHora,StringFormat=dd/MM/yyyy}" Width="95"/><DataGridTextColumn Header="Placa" Binding="{Binding Placa}" Width="90"/><DataGridTextColumn Header="Conductor" Binding="{Binding Conductor}" Width="*"/><DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*"/><DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="*"/><DataGridTextColumn Header="Ingreso kg" Binding="{Binding Peso,StringFormat=N2}" Width="100"/><DataGridTextColumn Header="Salida kg" Binding="{Binding PesoSalida,StringFormat=N2}" Width="100"/><DataGridTextColumn Header="Neto kg" Binding="{Binding PesoNeto,StringFormat=N2}" Width="100"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"/></DataGrid.Columns></DataGrid><TextBlock x:Name="txtResumen" Grid.Row="3" FontWeight="Bold" FontSize="14" Margin="4,12"/></Grid></Window>
